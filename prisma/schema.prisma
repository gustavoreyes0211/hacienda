// Prisma Schema para Sistema de Tienda con Facturación Electrónica DTE (Ministerio de Hacienda El Salvador) y Pagos Stripe
// Base de datos: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Configuración de la Empresa Emisora registrada en Ministerio de Hacienda
model Emisor {
  id                  String   @id @default(uuid())
  nit                 String   @unique // Formato 14 dígitos sin guiones
  nrc                 String   // Número de Registro de Contribuyente
  nombre              String   // Razón Social
  nombreComercial     String?
  codActividad        String   // Código de actividad económica según catálogo MH
  descActividad       String
  tipoEstablecimiento String   @default("01") // "01": Sucursal, "02": Casa Matriz
  departamento        String   @default("06") // "06": San Salvador
  municipio           String   @default("14") // "14": San Salvador Centro
  direccion           String
  telefono            String
  correo              String
  codEstablecimiento  String   @default("M001") // Código asignado por MH
  codPuntoVenta       String   @default("P001") // Código asignado por MH
  ambiente            String   @default("00")   // "00": Pruebas, "01": Producción
  claveApiHacienda    String?  // Contraseña de API otorgada por MH
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Directorio Fiscal de Clientes (Consumidores Finales y Empresas con NRC)
model Cliente {
  id             String   @id @default(uuid())
  tipoDocumento  String   @default("13") // "13": DUI, "36": NIT, "02": Pasaporte
  numDocumento   String   @unique
  nrc            String?  // Obligatorio para Créditos Fiscales (DTE 03)
  nombre         String
  nombreComercial String?
  codActividad   String?  // Actividad económica si es contribuyente
  descActividad  String?
  departamento   String   @default("06")
  municipio      String   @default("14")
  direccion      String
  telefono       String?
  correo         String   // Destino obligatorio del PDF y JSON firmado
  ventas         Venta[]
  dtes           DteDocumento[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Control de Inventario y Catálogo de Productos
model Producto {
  id          String      @id @default(uuid())
  sku         String      @unique
  nombre      String
  descripcion String?
  precio      Float       // Precio de venta en USD
  costo       Float       @default(0.0) // Costo de compra
  stock       Int         @default(0)
  stockMinimo Int         @default(5)
  esGravado   Boolean     @default(true) // Sujeto a 13% de IVA
  categoria   String      @default("General")
  itemsVenta  VentaItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Ventas y Órdenes de Tienda (Punto de Venta / Online)
model Venta {
  id               String        @id @default(uuid())
  correlativo      Int           @unique @default(autoincrement())
  clienteId        String
  cliente          Cliente       @relation(fields: [clienteId], references: [id])
  tipoDte          String        @default("01") // "01": Factura, "03": Crédito Fiscal
  subtotal         Float
  iva              Float
  descuento        Float         @default(0.0)
  total            Float
  metodoPago       String        // "STRIPE", "EFECTIVO", "TRANSFERENCIA"
  estado           String        @default("COMPLETADA") // "PENDIENTE", "COMPLETADA", "ANULADA"
  items            VentaItem[]
  pagoStripe       PagoStripe?
  dte              DteDocumento?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model VentaItem {
  id          String   @id @default(uuid())
  ventaId     String
  venta       Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id])
  cantidad    Int
  precioUni   Float
  esGravado   Boolean  @default(true)
  subtotal    Float
  createdAt   DateTime @default(now())
}

// Registro de Transacciones de Pagos Electrónicos con Stripe
model PagoStripe {
  id              String   @id @default(uuid())
  ventaId         String   @unique
  venta           Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  sessionId       String?  @unique
  paymentIntentId String?  @unique
  monto           Float
  moneda          String   @default("usd")
  estado          String   // "PENDING", "SUCCEEDED", "FAILED"
  receiptUrl      String?
  customerEmail   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Documentos Tributarios Electrónicos (DTE) con Sello de Hacienda
model DteDocumento {
  id               String   @id @default(uuid())
  ventaId          String   @unique
  venta            Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  clienteId        String
  cliente          Cliente  @relation(fields: [clienteId], references: [id])
  tipoDte          String   // "01" (Factura) o "03" (Crédito Fiscal)
  numeroControl    String   @unique // Ej: DTE-01-M001P001-000000000000001
  codigoGeneracion String   @unique // UUID v4 en mayúsculas
  ambiente         String   @default("00") // "00": Pruebas, "01": Producción
  estadoMH         String   @default("PROCESADO") // "PROCESADO", "RECHAZADO", "CONTINGENCIA"
  selloRecibido    String?  // Sello oficial retornado por el Ministerio de Hacienda
  fhProcesamiento  DateTime?
  qrUrl            String?  // URL oficial de consulta ciudadana
  jsonOriginal     String   // JSON sin firmar estructurado según esquema MH
  jsonFirmado      String   // JSON o token JWS con firma digital
  respuestaMH      String?  // Payload completo devuelto por /fesv/recepciondte
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Registro inmutable de Auditoría para Hacienda
model AuditoriaHacienda {
  id               String   @id @default(uuid())
  endpoint         String
  codigoGeneracion String?
  tipoDte          String?
  peticion         String
  respuesta        String
  httpStatus       Int
  createdAt        DateTime @default(now())
}
